//=====================================================//
//                 REQUIRED LIBRAREIES                 //
//=====================================================//

#include <AP_Common.h>
#include <AP_Math.h>
#include <AP_Param.h>
#include <AP_Progmem.h>
#include <AP_HAL.h>
#include <AP_HAL_AVR.h>

//=====================================================//
//                HARDWARE DECLARATION                 //
//=====================================================//

const AP_HAL::HAL& hal = AP_HAL_AVR_APM2;

//=====================================================//
//                 USER-SPECIFIED VARIABLES            //
//=====================================================//

int a=1, b=5, c=6;
float delta, x1, x2;

//=====================================================//
//                      VOID SETUP                     //
//=====================================================//

void setup(){
delta = b*b-4*a*c;
hal.console -> println("Solving x^2+5x+6=0");

if(delta>0){
x1 = (-b+sqrt(delta))/(2*a);
x2 = (-b-sqrt(delta))/(2*a);

hal.console -> printf("x1 = %.2f, x2 = %.2f\n",x1,x2);
}

else if (delta=0){
x1 = -b/(2*a);
hal.console -> printf("x1 = %.2f\n",x1);
}

else {
hal.console -> printf("No real roots");
}  

}

//=====================================================//
//                      VOID LOOP                      //
//=====================================================//
void loop(){

}

//======================================================//
//                       FUNCTIONS                      //                           
//======================================================//


AP_HAL_MAIN();
