def main():
    # colab으로 실행시 경로
    data_root = "/content/mnist_raw"

    print(f"데이터 루트: {data_root}")

    try:
        X_train, Y_train, y_train_int = load_mnist_raw(data_root, "training")
        X_test, Y_test, y_test_int = load_mnist_raw(data_root, "testing")
    except ValueError as e:
        print(f"\n[에러] {e}")
        return

    input_size = 784
    hidden_size = 128
    output_size = 10

    # 신경망 구성
    net = SimpleNeuralNet(input_size, hidden_size, output_size, seed=42)

    # 하이퍼파라미터
    epochs = 30
    batch_size = 64
    learning_rate = 0.05
    momentum = 0.9
    report_interval = 200

    print(f"\n학습 시작 (총 데이터: {X_train.shape[1]}개, 배치 사이즈: {batch_size})")
    print(f"Learning rate: {learning_rate}, Momentum: {momentum}")

    for epoch in range(epochs):
        print(f"\n=== Epoch {epoch + 1} 시작 ===")

        iterator = iterate_minibatches(
            X_train,
            Y_train,
            batch_size=batch_size,
            shuffle=True,
            seed=epoch
        )

        running_loss = 0.0
        running_correct = 0
        running_seen = 0
        step_count = 0

        for xb, yb in iterator:
            step_count += 1

            # 순전파 + 역전파 + 가중치 갱신
            net.forward(xb)
            loss = net.backward(
                xb,
                yb,
                learning_rate=learning_rate,
                momentum=momentum
            )

            pred = np.argmax(net.a2, axis=0)
            target = np.argmax(yb, axis=0)

            running_loss += loss * xb.shape[1]
            running_correct += np.sum(pred == target)
            running_seen += xb.shape[1]

            if step_count % report_interval == 0:
                avg_loss = running_loss / running_seen
                avg_acc = running_correct / running_seen

                print(f"[Epoch {epoch + 1}] Step {step_count} | "
                      f"최근 평균 Loss: {avg_loss:.4f} | Acc: {avg_acc:.4f}")

                running_loss = 0.0
                running_correct = 0
                running_seen = 0

        # 매 에폭 종료 후 test 데이터셋으로 검증
        print(f"--- Epoch {epoch + 1} 검증 중... ---")
        test_acc = accuracy_from_net(net, X_test, y_test_int)
        print(f"Epoch {epoch + 1} 완료 | 최종 Test Acc: {test_acc:.4f}")

    # colab 실행시 경로
    save_path = "/content/drive/MyDrive/weights_final.npz"

    # 학습 완료 후 가중치 최종 저장
    save_weights(net, save_path)

    rng = np.random.default_rng(0)
    idx = rng.choice(X_test.shape[1], size=10, replace=False)

    out = net.forward(X_test[:, idx])
    pred = np.argmax(out, axis=0)

    print("\n=== 테스트 예측 예시 ===")
    print("선택 인덱스:", idx)
    print("예측:", pred)
    print("정답:", y_test_int[idx])
