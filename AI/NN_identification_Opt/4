class SimpleNeuralNet:
    def __init__(self, input_size, hidden_size, output_size, seed=42):
        rng = np.random.default_rng(seed)

        # 기존 random initialization 방식 유지
        self.W1 = 0.01 * rng.standard_normal((hidden_size, input_size))
        self.b1 = np.zeros((hidden_size, 1))
        self.W2 = 0.01 * rng.standard_normal((output_size, hidden_size))
        self.b2 = np.zeros((output_size, 1))

        # Momentum용 velocity 변수
        self.vW1 = np.zeros_like(self.W1)
        self.vb1 = np.zeros_like(self.b1)
        self.vW2 = np.zeros_like(self.W2)
        self.vb2 = np.zeros_like(self.b2)

    def relu(self, z):
        return np.maximum(0, z)

    def relu_derivative(self, z):
        return (z > 0).astype(np.float32)

    def softmax(self, z):
        # overflow 방지를 위해 각 열마다 최댓값을 빼줌
        z_shift = z - np.max(z, axis=0, keepdims=True)
        exp_z = np.exp(z_shift)
        return exp_z / np.sum(exp_z, axis=0, keepdims=True)

    def forward(self, x):
        self.z1 = np.dot(self.W1, x) + self.b1
        self.a1 = self.relu(self.z1)

        self.z2 = np.dot(self.W2, self.a1) + self.b2
        self.a2 = self.softmax(self.z2)

        return self.a2

    def cross_entropy_loss(self, y):
        m = y.shape[1]
        eps = 1e-12

        loss = -np.sum(y * np.log(self.a2 + eps)) / m
        return loss

    def backward(self, x, y, learning_rate, momentum=0.9):
        m = x.shape[1]

        # Softmax + Cross Entropy의 핵심 gradient
        dz2 = self.a2 - y

        dW2 = (1 / m) * np.dot(dz2, self.a1.T)
        db2 = (1 / m) * np.sum(dz2, axis=1, keepdims=True)

        dz1 = np.dot(self.W2.T, dz2) * self.relu_derivative(self.z1)

        dW1 = (1 / m) * np.dot(dz1, x.T)
        db1 = (1 / m) * np.sum(dz1, axis=1, keepdims=True)

        # Momentum update
        self.vW1 = momentum * self.vW1 - learning_rate * dW1
        self.vb1 = momentum * self.vb1 - learning_rate * db1
        self.vW2 = momentum * self.vW2 - learning_rate * dW2
        self.vb2 = momentum * self.vb2 - learning_rate * db2

        self.W1 += self.vW1
        self.b1 += self.vb1
        self.W2 += self.vW2
        self.b2 += self.vb2

        loss = self.cross_entropy_loss(y)
        return loss

    def predict(self, x):
        out = self.forward(x)
        return np.argmax(out, axis=0)

    def get_params(self):
        return self.W1.copy(), self.b1.copy(), self.W2.copy(), self.b2.copy()

    def set_params(self, params):
        self.W1, self.b1, self.W2, self.b2 = params
